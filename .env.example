# Required for primary planning and answering. Runtime-limit handling is deterministic.
OPENAI_API_KEY=
BIM_MODEL=gpt-5.6-sol
BIM_REASONING_EFFORT=high
BIM_ENABLE_QUESTION_PLANNING=true
# Optional; defaults to BIM_MODEL.
BIM_PLANNING_MODEL=
# Keep primary answer synthesis at high effort; bounded helper stages use lower
# effort independently to avoid spending the same reasoning budget several times.
BIM_PLANNING_REASONING_EFFORT=medium
BIM_MODEL_TOOL_REASONING_EFFORT=medium

# Local defaults
BIM_DATA_DIR=test-project-data
# Optional multi-project layout: BIM_PROJECTS_ROOT/<project_id>/{tree,properties,ifc}.
# When configured, HTTP project_id selects the corresponding directory.
BIM_PROJECTS_ROOT=
BIM_TRACE_DIR=logs/traces
BIM_MAX_AGENT_ITERATIONS=40
BIM_MAX_TOOL_OUTPUT_CHARS=80000
# Optional hard estimated list-price guard per answer in USD. It is disabled until
# production cost observations support a threshold; use a positive amount to enable.
BIM_MAX_ANSWER_COST_USD=0

# On-device Python sandbox. The application never uploads project files to OpenAI
# Containers/Files APIs. Docker image installation is an explicit administrator step.
BIM_ENABLE_LOCAL_PYTHON=true
BIM_LOCAL_PYTHON_IMAGE=python:3.12-slim
BIM_PYTHON_MEMORY_LIMIT=4g
BIM_LOCAL_PYTHON_CPUS=1.0
BIM_LOCAL_PYTHON_TIMEOUT_SECONDS=120
BIM_LOCAL_PYTHON_OUTPUT_CHARS=40000
BIM_OPENAI_MAX_RETRIES=4
BIM_OPENAI_TIMEOUT_SECONDS=180

# Optional JSON override for USD prices per 1M tokens for custom/unlisted models.
# BIM_MODEL_PRICING_JSON={"private-model":{"input":1.5,"cached_input":0.2,"output":8.0}}
BIM_MODEL_PRICING_JSON=
