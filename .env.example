# Required for answering.
OPENAI_API_KEY=
BIM_MODEL=gpt-5.6-sol
BIM_REASONING_EFFORT=high

# Selected three-file BIM snapshot for direct CLI use.
BIM_DATA_DIR=test-project-data
# Evaluator-compatible project collection. Defaults to ./bim-data.
BIM_PROJECTS_ROOT=bim-data
BIM_SINGLE_PROJECT_ID=

BIM_TRACE_DIR=logs/traces
BIM_MAX_AGENT_ITERATIONS=30
BIM_MAX_TOOL_OUTPUT_CHARS=80000
BIM_OPENAI_MAX_RETRIES=4
BIM_OPENAI_TIMEOUT_SECONDS=180
BIM_PRETTY_LOGS=true

# Optional Bash executable override. Windows automatically discovers Git Bash.
BIM_BASH_PATH=
BIM_SHELL_TIMEOUT_SECONDS=120

# Optional JSON override for USD prices per 1M tokens for custom/unlisted models.
# BIM_MODEL_PRICING_JSON={"private-model":{"input":1.5,"cached_input":0.2,"output":8.0}}
BIM_MODEL_PRICING_JSON=
