# Required. There is no offline or deterministic answer fallback.
OPENAI_API_KEY=
BIM_MODEL=gpt-5.6-sol
BIM_REASONING_EFFORT=medium

# Local defaults
BIM_DATA_DIR=test-project-data
# Optional multi-project layout: BIM_PROJECTS_ROOT/<project_id>/{tree,properties,ifc}.
# When configured, HTTP project_id selects the corresponding directory.
BIM_PROJECTS_ROOT=
BIM_TRACE_DIR=logs/traces
BIM_MAX_AGENT_ITERATIONS=40
BIM_MAX_TOOL_OUTPUT_CHARS=80000

# Hosted Python analysis. Project files are uploaded to an isolated OpenAI container.
BIM_ENABLE_HOSTED_PYTHON=false
BIM_PYTHON_MEMORY_LIMIT=4g
BIM_PYTHON_EXPIRY_MINUTES=120
BIM_OPENAI_MAX_RETRIES=4
BIM_OPENAI_TIMEOUT_SECONDS=180
